  // Type check only: main.js stays plain JavaScript and is never compiled
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "skipLibCheck": true
  },
  "files": ["main.js"]
}
