{
  "now": "2026-01-02 03:04",
  "about": "Each case runs nextLine(input) with the default settings plus `settings`, at `now`. `marks` is a shorthand that sets the marks of the default states by symbol. `expected: null` means the line is not a task.",
  "cases": [
    { "name": "[ ] -> [~] adds the in-progress mark", "input": "- [ ] a", "expected": "- [~] a 🛫 2026-01-02 03:04" },
    { "name": "[~] -> [x] adds the done mark", "input": "- [~] a 🛫 2026-01-01 10:00", "expected": "- [x] a 🛫 2026-01-01 10:00 ✅ 2026-01-02 03:04" },
    { "name": "[x] -> [-] adds nothing", "input": "- [x] a ✅ 2026-01-01 10:00", "expected": "- [-] a ✅ 2026-01-01 10:00" },
    { "name": "[-] -> [ ] keeps the times by default", "input": "- [-] a 🛫 2026-01-01 10:00", "expected": "- [ ] a 🛫 2026-01-01 10:00" },
    { "name": "a state not in the cycle goes to the first state", "input": "- [?] a", "expected": "- [ ] a" },
    { "name": "not a task: plain list item", "input": "- a", "expected": null },
    { "name": "not a task: text", "input": "a [ ] b", "expected": null },
    { "name": "ordered list", "input": "1. [ ] a", "expected": "1. [~] a 🛫 2026-01-02 03:04" },
    { "name": "ordered list with )", "input": "2) [ ] a", "expected": "2) [~] a 🛫 2026-01-02 03:04" },
    { "name": "* bullet", "input": "* [ ] a", "expected": "* [~] a 🛫 2026-01-02 03:04" },
    { "name": "+ bullet", "input": "+ [ ] a", "expected": "+ [~] a 🛫 2026-01-02 03:04" },
    { "name": "indented task", "input": "    - [ ] a", "expected": "    - [~] a 🛫 2026-01-02 03:04" },
    { "name": "already stamped: no second time", "input": "- [ ] a 🛫 2026-01-01 10:00", "expected": "- [~] a 🛫 2026-01-01 10:00" },
    { "name": "mark left at the end: time inserted after it", "input": "- [ ] a 🛫", "expected": "- [~] a 🛫 2026-01-02 03:04" },
    { "name": "mark left with trailing spaces", "input": "- [ ] a 🛫   ", "expected": "- [~] a 🛫 2026-01-02 03:04" },
    { "name": "mark left before another mark", "input": "- [ ] a 🛫 ✅ 2026-01-01 10:00", "expected": "- [~] a 🛫 2026-01-02 03:04 ✅ 2026-01-01 10:00" },
    { "name": "mark left before text", "input": "- [ ] a 🛫 memo", "expected": "- [~] a 🛫 2026-01-02 03:04 memo" },
    { "name": "time left without its mark: a new stamp is appended", "input": "- [ ] a 2026-01-01 10:00", "expected": "- [~] a 2026-01-01 10:00 🛫 2026-01-02 03:04" },
    { "name": "incomplete time when stamping: left for the user to fix", "input": "- [ ] a 🛫 2026-01-0", "expected": "- [~] a 🛫 2026-01-0" },
    { "name": "custom format", "settings": { "dateFormat": "MMM D HH:mm" }, "input": "- [ ] a", "expected": "- [~] a 🛫 Jan 2 03:04" },
    { "name": "custom format: a time in that format counts", "settings": { "dateFormat": "MMM D HH:mm" }, "input": "- [ ] a 🛫 Dec 31 10:00", "expected": "- [~] a 🛫 Dec 31 10:00" },
    { "name": "custom format: a time in an earlier format still counts", "settings": { "dateFormat": "MMM D HH:mm" }, "input": "- [ ] a 🛫 2025-12-31 10:00", "expected": "- [~] a 🛫 2025-12-31 10:00" },
    { "name": "empty mark: no time", "settings": { "marks": { "~": "" } }, "input": "- [ ] a", "expected": "- [~] a" },
    { "name": "Nerd Font marks, other marks kept", "settings": { "marks": { "~": "󱓞", "x": "󰈼" } }, "input": "- [ ] a 󰂞 2026-01-01 09:00", "expected": "- [~] a 󰂞 2026-01-01 09:00 󱓞 2026-01-02 03:04" },
    { "name": "custom cycle", "settings": { "states": [{ "symbol": " ", "mark": "" }, { "symbol": "x", "mark": "✅" }, { "symbol": "🔥", "mark": "🔥" }]}, "input": "- [ ] c", "expected": "- [x] c ✅ 2026-01-02 03:04" },
    { "name": "custom cycle: a mark equal to the symbol is not mistaken for a stamp", "settings": { "states": [{ "symbol": " ", "mark": "" }, { "symbol": "x", "mark": "✅" }, { "symbol": "🔥", "mark": "🔥" }]}, "input": "- [x] c", "expected": "- [🔥] c 🔥 2026-01-02 03:04" },
    { "name": "custom cycle: wraps to the first state", "settings": { "states": [{ "symbol": " ", "mark": "" }, { "symbol": "x", "mark": "✅" }, { "symbol": "🔥", "mark": "🔥" }]}, "input": "- [🔥] c", "expected": "- [ ] c" },
    { "name": "clear: removes every stamp", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-01 10:00 ✅ 2026-01-01 11:00", "expected": "- [ ] a" },
    { "name": "clear: keeps marks that are not configured", "settings": { "clearOnUncheck": true}, "input": "- [-] a 󰂞 2026-01-01 09:00 🛫 2026-01-01 10:00", "expected": "- [ ] a 󰂞 2026-01-01 09:00" },
    { "name": "clear: keeps a mark without a time", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 memo ✅ 2026-01-01 11:00", "expected": "- [ ] a 🛫 memo" },
    { "name": "clear: keeps text between stamps", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-01 10:00 [link](x) ✅ 2026-01-01 11:00", "expected": "- [ ] a [link](x)" },
    { "name": "clear: a time in an earlier format", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 12/31 10:00", "expected": "- [ ] a" },
    { "name": "clear: a complete time followed by a number", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-01 10:00 3 items", "expected": "- [ ] a 3 items" },
    { "name": "clear: a time in an earlier format followed by a number takes the number too (known limitation)", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 12/31 10:00 3 items", "expected": "- [ ] a items" },
    { "name": "clear: incomplete date", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-0 end", "expected": "- [ ] a end" },
    { "name": "clear: incomplete time (hour only)", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-01 1 end", "expected": "- [ ] a end" },
    { "name": "clear: incomplete time (hour and colon)", "settings": { "clearOnUncheck": true}, "input": "- [-] a 🛫 2026-01-01 10: end", "expected": "- [ ] a end" },
    { "name": "clear: only when going back to [ ]", "settings": { "clearOnUncheck": true}, "input": "- [x] a 🛫 2026-01-01 10:00", "expected": "- [-] a 🛫 2026-01-01 10:00" }
  ]
}
